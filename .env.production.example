# Spring profile
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mim_db
SPRING_DATASOURCE_USERNAME=mim_user
SPRING_DATASOURCE_PASSWORD=change_me

# Auth
JWT_SECRET=change-me-32chars-minimum-secret
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SAME_SITE=None
AUTH_REFRESH_COOKIE_SECURE=true
GOOGLE_OAUTH_CLIENT_ID=google-client-id.apps.googleusercontent.com

# CORS
APP_CORS_ALLOWED_ORIGINS=https://app.example.com

# Redis
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=change_me
APP_REDIS_MAX_MEMORY=512mb

# MinIO
APP_MINIO_ENDPOINT=http://minio:9000
APP_MINIO_ACCESS_KEY=minio_admin
APP_MINIO_SECRET_KEY=change_me
APP_MINIO_BUCKET=mim-production-bucket

# Multipart limits (optional)
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=20MB
